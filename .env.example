# ==============================================================================
# PROOFVAULT AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before running the application:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB)
# ------------------------------------------------------------------------------
# Local MongoDB connection string or MongoDB Atlas URI
MONGODB_URI=mongodb://localhost:27017/proofvault

# ------------------------------------------------------------------------------
# 2. IPFS DECENTRALIZED STORAGE (Pinata)
# ------------------------------------------------------------------------------
# Pinata API credentials (obtain from https://app.pinata.cloud/developers/api-keys)
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_API_KEY=your_pinata_secret_api_key_here
PINATA_JWT=your_pinata_jwt_bearer_token_here
NEXT_PUBLIC_GATEWAY_URL=gateway.pinata.cloud

# ------------------------------------------------------------------------------
# 3. BLOCKCHAIN & WEB3 CONFIGURATION (Polygon Amoy Testnet)
# ------------------------------------------------------------------------------
# EVM Deployer/Relayer private key (without 0x prefix or with 0x prefix)
# CAUTION: Never commit real private keys or use accounts holding mainnet funds.
PRIVATE_KEY=your_evm_wallet_private_key_here

# Polygon Amoy RPC URL (Default public RPC or private endpoint from Alchemy/Infura)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Smart Contract Addresses (Populated after running Hardhat deploy script)
NEXT_PUBLIC_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
NEXT_PUBLIC_PROOF_NFT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
NEXT_PUBLIC_LICENSING_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
NEXT_PUBLIC_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# ------------------------------------------------------------------------------
# 4. BACKEND & AI MICROSERVICE CONFIGURATION
# ------------------------------------------------------------------------------
# FastAPI Neural Engine endpoint
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secret key used for signing JWT session tokens and SIWE authentication
JWT_SECRET=proofvault_production_jwt_super_secret_signing_key_32_chars_min

# ------------------------------------------------------------------------------
# 6. EXTERNAL AI & LLM ENHANCEMENT (Optional)
# ------------------------------------------------------------------------------
# Google Gemini API key for automated metadata enhancement and multimodal audits
GEMINI_API_KEY=your_google_gemini_api_key_here
